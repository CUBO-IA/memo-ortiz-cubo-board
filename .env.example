# Copiá este archivo a .env y completá los valores. .env nunca va al repositorio.

# ID del calendario "CUBO Board" dentro de tu cuenta de Google.
# Se ve en Google Calendar → configuración del calendario → "ID del calendario".
CALENDARIO_ID=

# ID de la carpeta "CUBO Board" en Google Drive.
# Es la parte final de la URL de la carpeta: drive.google.com/drive/folders/<ID>
CARPETA_DRIVE_ID=

# Modelo con el que corre el agente (sonnet es suficiente y más barato).
MODELO_AGENTE=sonnet

# Puerto del servidor local.
PORT=8790
